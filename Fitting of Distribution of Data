        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import norm\n",
        "\n",
        "# Replace with your dataset column\n",
        "data = df['Data'].values\n",
        "\n",
        "# 1. Histogram of the data\n",
        "plt.hist(data, bins=20, density=True, alpha=0.6, color='g', label='Data histogram')\n",
        "\n",
        "# Fit Normal distribution\n",
        "mu, sigma = np.mean(data), np.std(data, ddof=1)\n",
        "x = np.linspace(min(data), max(data), 200)\n",
        "plt.plot(x, norm.pdf(x, mu, sigma), 'r-', lw=2, label='Normal fit')\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# 2. Method of Moments (Normal distribution)\n",
        "mu_mom = np.mean(data)\n",
        "sigma_mom = np.std(data, ddof=0)  # population variance\n",
        "print(\"MoM estimates: mu =\", mu_mom, \", sigma =\", sigma_mom)\n",
        "\n",
        "# 3. Maximum Likelihood (Normal distribution)\n",
        "mu_mle = np.mean(data)\n",
        "sigma_mle = np.std(data, ddof=1)  # sample variance\n",
        "print(\"MLE estimates: mu =\", mu_mle, \", sigma =\", sigma_mle)\n",
        "\n",
        "# 4. Bootstrap Confidence Intervals\n",
        "n_boot = 1000\n",
        "boot_mu = []\n",
        "boot_sigma = []\n",
        "for _ in range(n_boot):\n",
        "    sample = np.random.choice(data, size=len(data), replace=True)\n",
        "    boot_mu.append(np.mean(sample))\n",
        "    boot_sigma.append(np.std(sample, ddof=1))\n",
        "\n",
        "mu_ci = np.percentile(boot_mu, [2.5, 97.5])\n",
        "sigma_ci = np.percentile(boot_sigma, [2.5, 97.5])\n",
        "\n",
        "print(\"Bootstrap 95% CI for mu:\", mu_ci)\n",
        "print(\"Bootstrap 95% CI for sigma:\", sigma_ci)\n",
        "\n"
      ],
